# Датчики доступны пользователю без root, питание USB не отключается
# Kinect v2 (Xbox One) — базовый: сам датчик 02c4, адаптер Kinect Adapter 02d8 и 02d9
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02c4", MODE="0666", ATTR{power/autosuspend}="-1"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02d8", MODE="0666", ATTR{power/autosuspend}="-1"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02d9", MODE="0666", ATTR{power/autosuspend}="-1"
# Kinect v1 (Xbox 360) — дешёвая альтернатива: камера 02ae, мотор 02b0, аудио 02ad
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02ae", MODE="0666", ATTR{power/autosuspend}="-1"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02b0", MODE="0666", ATTR{power/autosuspend}="-1"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02ad", MODE="0666", ATTR{power/autosuspend}="-1"
# Orbbec — будущий аналог
SUBSYSTEM=="usb", ATTR{idVendor}=="2bc5", MODE="0666", ATTR{power/autosuspend}="-1"
