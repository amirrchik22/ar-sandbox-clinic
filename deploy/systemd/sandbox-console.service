[Unit]
Description=AR-песочница: Консоль специалиста
After=graphical.target sandbox-depth.service

[Service]
User=sandbox
WorkingDirectory=/opt/ar-sandbox-clinic
Environment=DISPLAY=:0
ExecStart=/opt/ar-sandbox-clinic/.venv/bin/uvicorn sandbox.console.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
