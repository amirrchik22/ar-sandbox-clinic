[Unit]
Description=AR-песочница: Сервис датчика глубины
After=graphical.target 

[Service]
User=sandbox
WorkingDirectory=/opt/ar-sandbox-clinic
Environment=DISPLAY=:0
ExecStart=/opt/ar-sandbox-clinic/.venv/bin/python -m sandbox.depth_service --sensor kinect2
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
