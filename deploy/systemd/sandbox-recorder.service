[Unit]
Description=AR-песочница: Рекордер сеансов
After=graphical.target sandbox-depth.service

[Service]
User=sandbox
WorkingDirectory=/opt/ar-sandbox-clinic
Environment=DISPLAY=:0
ExecStart=/opt/ar-sandbox-clinic/.venv/bin/python -m sandbox.recorder.main
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
